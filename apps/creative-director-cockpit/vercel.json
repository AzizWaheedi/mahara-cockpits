{
  "redirects": [
    {
      "source": "/",
      "destination": "/creative/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/creative/assets/:path*",
      "destination": "/assets/:path*"
    },
    {
      "source": "/creative/apple-touch-icon.png",
      "destination": "/apple-touch-icon.png"
    },
    {
      "source": "/creative/favicon.ico",
      "destination": "/favicon.ico"
    },
    {
      "source": "/creative/favicon.png",
      "destination": "/favicon.png"
    },
    {
      "source": "/((?!assets/|__viktor_meta\\.json).*)",
      "destination": "/index.html"
    }
  ]
}

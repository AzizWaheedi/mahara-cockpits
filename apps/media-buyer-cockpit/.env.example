# Convex deployment URL (set by init_app_project tool or npx convex dev)
VITE_CONVEX_URL=

# For local development with npx convex dev
# CONVEX_DEPLOY_KEY=

# Auth private key (RSA 2048, generated automatically)
# AUTH_PRIVATE_KEY=

# Viktor Spaces auth mode: public (no accounts) or authenticated
VITE_VIKTOR_SPACES_ACCESS_MODE=authenticated

# Sign-in providers for authenticated apps. Use ["email_password"], ["viktor"], or both.
VITE_VIKTOR_SPACES_AUTH_PROVIDERS='["email_password"]'

# Stable Space id from Viktor; enables "Sign in with Viktor"
VITE_VIKTOR_SPACES_SPACE_ID=

# Viktor backend URL; enables "Sign in with Viktor"
VITE_VIKTOR_SPACES_API_URL=

# Optional explicit Viktor OAuth client id. Defaults to space-$VITE_VIKTOR_SPACES_SPACE_ID.
VITE_VIKTOR_AUTH_CLIENT_ID=

# --- Outside Viktor: keep auth on, email/password only (the Viktor SSO is simply absent)
# VITE_VIKTOR_SPACES_ACCESS_MODE=authenticated   (already above)
# VITE_VIKTOR_SPACES_AUTH_PROVIDERS='["email_password"]'   (already above)

# --- Convex deployment env (set with `bunx convex env set NAME value`, not in this file):
# VIKTOR_SPACES_ACCESS_MODE=authenticated
# VIKTOR_SPACES_AUTH_PROVIDERS=["email_password"]
# SITE_URL=https://<your-vercel-url>
# JWT_PRIVATE_KEY / JWKS  (generated, see HOSTING.md)
# RESEND_API_KEY, AUTH_EMAIL_FROM        sign-up verification + password reset emails
# CLICKUP_API_TOKEN                      ClickUp reads/writes
# GOOGLE_SERVICE_ACCOUNT_JSON            Google Sheets (share the sheets with the service account)
# TYPEFORM_TOKEN                         Typeform responses
# SUPABASE_ACCESS_TOKEN                  Creative Triage Supabase (read-only SQL)
# SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY Direct cockpit data (server only)
# SUPABASE_MIGRATION_DRY_RUN=true        No shadow writes until explicitly set to false
# SLACK_BOT_TOKEN                        EOD posts and feedback (chat:write)
# ANTHROPIC_API_KEY, ANTHROPIC_MODEL     ad copy variants, quick AI search
# META_SYSTEM_TOKEN                      Meta Marketing API (system-user token)

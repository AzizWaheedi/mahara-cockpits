# The Convex deployment this site talks to. `bunx convex dev` writes it into
# .env.local for local work; scripts/ship.sh passes it for production builds.
VITE_CONVEX_URL=

# --- Deployment environment (never in this file; set them with:
#     bunx convex env set NAME value )
#
# COMPOSIO_API_KEY           the Composio consumer key; the one door to Notion,
#                            Gmail and Google Drive (x-consumer-api-key)
# MEMORY_CORE_ACCESS_CODE    the access code every read and write checks on the
#                            server; without it the app is closed to everyone
# ANTHROPIC_API_KEY          Claude writes the grounded answers
# ANTHROPIC_MODEL            optional, defaults to claude-opus-5
# OPENAI_API_KEY             the fallback that writes answers when Claude has no
#                            key on this deployment
# OPENAI_MODEL               optional, defaults to gpt-4.1-mini

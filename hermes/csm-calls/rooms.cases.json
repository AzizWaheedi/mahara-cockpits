  { "input": "HTTPS://MEET.GOOGLE.COM/abc-defg-hij", "expected": "meet:abc-defg-hij", "note": "an upper-case scheme and host" },
  { "input": "meet.google.com/kln-opqr-stu", "expected": "meet:kln-opqr-stu", "note": "no scheme" },
  { "input": "https://meet.google.com/lookup/test", "expected": null, "note": "a Meet link with no meeting code" },
  { "input": "https://teams.microsoft.com/l/meetup-join/19%3ameeting_TEST%40thread.v2/0", "expected": null, "note": "Microsoft Teams" },
  { "input": "https://maps.app.goo.gl/TESTTESTTEST", "expected": null, "note": "a map link" },
  { "input": "https://www.google.com/maps/place/Test+Office", "expected": null, "note": "a Google Maps place" },
  { "input": "https://fathom.video/share/TEST", "expected": null, "note": "a Fathom link is not a room" },
  { "input": "Office", "expected": null, "note": "a place name, not a link" },

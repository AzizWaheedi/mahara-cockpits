[
  { "input": "https://us05web.zoom.us/j/12345678901?pwd=TEST", "expected": "zoom:12345678901", "note": "Zoom us05web link with a passcode: the meeting id only" },
  { "input": "https://us06web.zoom.us/j/12345678901?pwd=TEST", "expected": "zoom:12345678901", "note": "the same meeting on us06web is the same room" },
  { "input": "https://us02web.zoom.us/j/12345678901?pwd=TEST&from=addon", "expected": "zoom:12345678901", "note": "more query after the passcode" },
  { "input": "https://zoom.us/j/12345678901", "expected": "zoom:12345678901", "note": "zoom.us/j with no subdomain" },
  { "input": "https://zoom.us/j/12345678901#success", "expected": "zoom:12345678901", "note": "a fragment" },
  { "input": "https://us05web.zoom.us/j/12345678901/", "expected": "zoom:12345678901", "note": "a trailing slash" },
  { "input": "https://us06web.zoom.us/w/12345678901?pwd=TEST", "expected": "zoom:12345678901", "note": "a zoom.us/w link" },
  { "input": "https://zoom.us/s/12345678901", "expected": "zoom:12345678901", "note": "a zoom.us/s link (the host's start link)" },
  { "input": "https://example.zoom.us/j/98765432101?pwd=TEST", "expected": "zoom:98765432101", "note": "a company subdomain, another meeting" },
  { "input": "https://zoom.us/j/123456789", "expected": "zoom:123456789", "note": "9 digits, the shortest meeting id" },
  { "input": "https://zoom.us/j/123456789012", "expected": "zoom:123456789012", "note": "12 digits, the longest meeting id" },
  { "input": "https://zoom.us/j/12345678", "expected": null, "note": "8 digits is not a meeting id" },
  { "input": "https://zoom.us/my/test.room", "expected": null, "note": "a personal link name carries no meeting id" },
  { "input": "HTTPS://US05WEB.ZOOM.US/J/12345678901?pwd=TEST", "expected": "zoom:12345678901", "note": "upper case is lowered first" },
  { "input": "  https://zoom.us/j/12345678901  ", "expected": "zoom:12345678901", "note": "spaces around the link" },
  { "input": "https://meet.google.com/abc-defg-hij", "expected": "meet:abc-defg-hij", "note": "a Google Meet link" },
  { "input": "https://meet.google.com/abc-defg-hij?authuser=0", "expected": "meet:abc-defg-hij", "note": "Meet with authuser is the same room" },
  { "input": "https://meet.google.com/kln-opqr-stu?authuser=1&hs=122", "expected": "meet:kln-opqr-stu", "note": "Meet with authuser and more query" },

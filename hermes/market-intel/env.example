# ~/.market-intel/env (mode 600). Names only: fill the values on the VPS, never in Git.
MARKET_INTEL_SUPABASE_URL=
MARKET_INTEL_SUPABASE_KEY=
# A key of its own (the CEO picks: a separate Apify key, or the radar's APIFY_API_KEY is used with a doctor warning).
MARKET_INTEL_APIFY_KEY=
SCRAPECREATORS_API_KEY=
# vps (default: the Claude proxy at 127.0.0.1:3456, the CEO's sign-in) or cli (claude -p with this setup token).
MARKET_INTEL_MODEL_PROVIDER=vps
# CLAUDE_CODE_OAUTH_TOKEN=
# Caps in USD; the lower of these and the setting market_intel wins.
MARKET_INTEL_USD_CAP_RUN=2
MARKET_INTEL_USD_CAP_MONTH=25
# MI-3 (publishing), not read in shadow:
# MARKET_INTEL_GOOGLE_KEY_FILE=
# MARKET_INTEL_TEMPLATE_DOC=
# MARKET_INTEL_APPLY=false
